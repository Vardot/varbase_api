<?php

/**
 * @file
 * Contains varbase_api.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\varbase_api\Hook\VarbaseApiHooks;
use Drupal\views\ViewEntityInterface;

/**
 * Implements hook_entity_insert().
 */
#[LegacyHook]
function varbase_api_entity_insert(EntityInterface $entity) {
  \Drupal::service(VarbaseApiHooks::class)->entityInsert($entity);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function varbase_api_view_presave(ViewEntityInterface $view) {
  \Drupal::service(VarbaseApiHooks::class)->viewPresave($view);
}

/**
 * Implements hook_entity_operation().
 */
#[LegacyHook]
function varbase_api_entity_operation(EntityInterface $entity) {
  return \Drupal::service(VarbaseApiHooks::class)->entityOperation($entity);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function varbase_api_form_oauth2_token_settings_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(VarbaseApiHooks::class)->formOauth2TokenSettingsAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_entity_bundle_create().
 */
#[LegacyHook]
function varbase_api_entity_bundle_create($entity_type_id, $bundle) {
  \Drupal::service(VarbaseApiHooks::class)->entityBundleCreate($entity_type_id, $bundle);
}

/**
 * Check if the JSON:API resource config was enabled for this entity.
 *
 * Legacy procedural wrapper kept for backwards compatibility.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE when the JSON:API resource config is enabled, FALSE otherwise.
 */
function varbase_api_is_jsonapi_resource_config_enabled(EntityInterface $entity) {
  return \Drupal::service(VarbaseApiHooks::class)->isJsonapiResourceConfigEnabled($entity);
}

/**
 * Get the View JSON:API operation URL for this entity.
 *
 * Legacy procedural wrapper kept for backwards compatibility.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to build the URL for.
 *
 * @return \Drupal\Core\Url|string
 *   The operation URL, or an empty string when it cannot be built yet.
 */
function varbase_api_get_view_json_operation_url(EntityInterface $entity) {
  return \Drupal::service(VarbaseApiHooks::class)->getViewJsonOperationUrl($entity);
}

/**
 * Get the View API Docs operation URL for this entity.
 *
 * Legacy procedural wrapper kept for backwards compatibility.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to build the URL for.
 *
 * @return \Drupal\Core\Url|string
 *   The operation URL, or an empty string when it cannot be built yet.
 */
function varbase_api_get_view_api_docs_operation_url(EntityInterface $entity) {
  return \Drupal::service(VarbaseApiHooks::class)->getViewApiDocsOperationUrl($entity);
}
