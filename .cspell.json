{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore",
    ".yarn/**",
    "tests/reports/**",
    "tests/screenshots/**",
    "tests/videos/**",
    "**/*.map",
    "**/dist/**",
    "**/build/**"
