{
  "version": "0.2",
  "language": "en-US",
  "allowCompoundWords": false,
  "globRoot": ".",
  "ignorePaths": [
    "node_modules/**",
    "vendor/**",
    "*.min.js",
    "*.min.css",
    "composer.lock",
    "package-lock.json",
    "yarn.lock",
    "**/.*.json",
    ".*ignore",
    ".yarn/**",
    ".yarnrc.yml"
  ],
  "words": [
    "varbase",
    "Varbase",
    "vardot",
    "Vardot",
    "phpcs",
    "phpcbf",
    "drupal",
    "Drupal",
    "jsonapi",
    "langcode",
    "metatag",
    "restui",
    "oembed",
    "yoast",
    "heroslider",
    "redoc",
    "isset",
    "sprintf",
    "Symfony",
    "KEYTYPE",
    "LANGCODE",
    "drush",
    "composerize",
    "entityqueue",
    "viewsreference",
    "webform",
    "readonly",
    "subqueue",
    "filemime",
    "filesize",
    "linkit",
    "pathauto",
    "userprotect",
    "likert",
    "Scaned"
  ]
}
